# ===========================================
# Trellis Frontend — environment variables
# ===========================================
# Copy this file to .env and adjust if your API is not on localhost:5000.
# .env is gitignored.
#
# These are read at BUILD time and baked into the bundle. Anything prefixed
# VITE_ is visible to anyone who loads the site — never put a secret here.

# Base URL of the Trellis REST API.
VITE_API_URL=http://localhost:5000/api

# Origin of the Socket.io server. Usually the API without the /api path.
VITE_SOCKET_URL=http://localhost:5000

# Public origin of this site. Used for canonical links, Open Graph tags and
# sitemap.xml. Set this to the real origin in your hosting platform's build
# environment when you deploy.
VITE_SITE_URL=http://localhost:5173
